# Copy to .env — loaded by backend/settings.py.
# The frontend (separate 'frontend-aica-ui' branch) has its own .env.example
# for VITE_BACKEND_WS_URL/VITE_BACKEND_WS_TOKEN, pointing at this backend's
# /ws/audio endpoint (see backend/main.py).

# Ollama / any OpenAI-compatible endpoint for the conversation LLM.
#
# LLM_MODEL must name a model whose num_ctx is set EXPLICITLY - build it from the
# repo-root Modelfile (`ollama create aruvi-base -f Modelfile`), which pins 8192.
# Easiest: `python -m backend.scripts.setup_model` builds it from the best base you
# actually have installed, and says so if it had to fall back to a weaker one.
# Pointing this at a bare tag like `qwen3:4b-instruct-2507-q4_K_M` lets Ollama pick
# a VRAM-derived default (often 2048-4096) that silently truncates the system
# prompt before its language rules - the agent then answers in English and invents
# identifiers. See SETUP.md.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=aruvi-base
LLM_API_KEY=ollama

# TTS. "edge" (default) = Microsoft neural voices: no API key, no download, CPU.
# TTS_VOICE blank picks the female voice mapped for TTS_LANGUAGE
# (Tamil -> ta-IN-PallaviNeural). Set it to override, e.g. ta-IN-ValluvarNeural
# for the male voice. "svara" selects the placeholder adapter, which still raises.
#
# PRIVACY: "edge" sends each reply's TEXT to Microsoft to be synthesized. Fine for
# the fictional Aruvi test data, NOT for real patient speech — swap in a
# self-hosted engine (AI4Bharat Indic Parler-TTS) before that. See SETUP.md.
TTS_ENGINE=edge
# TTS_VOICE=

# Required for the gated ASR model — see backend/README.md. Without it the
# microphone path is unavailable, but /console's typed turns still exercise the
# full conversation -> LLM -> tool -> TTS chain.
# HF_TOKEN=hf_your_token_here
# Optional — only set this if you want the /ws/audio handshake to require a
# shared-secret token (checked against a client's ?token= query param).
# AUDIO_WS_AUTH_TOKEN=

# Voice pacing. +10% is slightly slower than the earlier +15%; Edge's large
# per-clip padding is trimmed to an 80 ms full-stop/inter-clause pause.
# TTS_RATE=+10%
# TTS_CLAUSE_PAUSE_SECONDS=0.08

# Noise-resistant turn detection. Both gates are on the TEN VAD FLAG only -
# never add an energy/SNR gate behind them, it was tried and it rejected real
# speech on a quiet mic (see HANDOFF.md Sec5).
#   START  consecutive 16ms hops before a turn opens (4 = 64ms). Candidate
#          audio is kept, so this never clips the first syllable.
#   RESUME consecutive hops needed to restart the endpoint countdown. Raise if
#          a noisy room still holds the microphone open after you stop talking.
# VAD_START_FRAMES=4
# VAD_RESUME_FRAMES=3
# VAD_BARGE_IN_FRAMES=15
# VAD_BARGE_IN_FRAMES_WHILE_AUDIBLE=40
#
# Loudness at ONSET - only speech this loud may OPEN a turn, so a TV or a
# conversation across the room no longer starts one. Read in exactly ONE place
# (the not-yet-in-speech branch); once a turn is open, only the VAD flag ends
# it. That split is deliberate: an energy gate on EVERY frame was tried and
# reverted, because a quiet trailing syllable scored as silence and turns came
# back as one-character transcripts.
#   SNR      multiple of the learned room noise. RAISE THIS FIRST if a noisy
#            room still opens turns.
#   MIN_RMS  absolute backstop, int16 RMS. Real speech runs ~931 (p10) to
#            ~2624 (p50) per frame, so 200 is a floor, not a filter. Lower it
#            if a soft-spoken caller is being ignored.
#
# The WATCHDOG: a turn ends when nothing LOUD has arrived for this long,
# whatever the VAD is flagging. Must exceed VAD_ENDPOINT_SILENCE_FRAMES -
# equal would make a quiet syllable mean the same as silence. Lower it toward
# 30 if turns still feel slow to close after you stop speaking.
# VAD_QUIET_ENDPOINT_FRAMES=44
# VAD_ONSET_SNR=3.0
# VAD_ONSET_MIN_RMS=200
# VAD_NOISE_EMA=0.05

# Voice pacing. Edge pads every clip it returns and that padding is the long
# gap after a full stop; it is trimmed to one deliberate inter-clause pause.
# TTS_RATE=+10%
# TTS_CLAUSE_PAUSE_SECONDS=0.08
