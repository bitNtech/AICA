# Copy to .env and point at your local/staging backend.
# Used only by Simulation & Testing → DirectTestingPanel to open a real
# test-call session over the backend's /ws/audio contract
# (see backend/main.py).
VITE_BACKEND_WS_URL=ws://localhost:8000/ws/audio

# Optional — only set this if the backend has AUDIO_WS_AUTH_TOKEN configured
# (backend/settings.py's SecuritySettings). Leave unset for local dev, where
# the backend ships with auth off by default.
# VITE_BACKEND_WS_TOKEN=

# --- Backend (Python/FastAPI) settings — same .env file, loaded by backend/settings.py ---
# Ollama / any OpenAI-compatible endpoint for the conversation LLM.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
# Required for the gated ASR model — see backend/README.md.
# HF_TOKEN=hf_your_token_here
