# Copy to .env — loaded by backend/settings.py.
# The frontend (separate 'frontend-aica-ui' branch) has its own .env.example
# for VITE_BACKEND_WS_URL/VITE_BACKEND_WS_TOKEN, pointing at this backend's
# /ws/audio endpoint (see backend/main.py).

# Ollama / any OpenAI-compatible endpoint for the conversation LLM.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama

# Required for the gated ASR model — see backend/README.md.
# HF_TOKEN=hf_your_token_here

# Optional — only set this if you want the /ws/audio handshake to require a
# shared-secret token (checked against a client's ?token= query param).
# AUDIO_WS_AUTH_TOKEN=
