# Copy to .env — loaded by backend/settings.py.
# The frontend (separate 'frontend-aica-ui' branch) has its own .env.example
# for VITE_BACKEND_WS_URL/VITE_BACKEND_WS_TOKEN, pointing at this backend's
# /ws/audio endpoint (see backend/main.py).

# Ollama / any OpenAI-compatible endpoint for the conversation LLM.
#
# LLM_MODEL must name a model whose num_ctx is set EXPLICITLY - build it from the
# repo-root Modelfile (`ollama create aruvi-base -f Modelfile`), which pins 8192.
# Pointing this at a bare tag like `qwen3:4b-instruct-2507-q4_K_M` lets Ollama pick
# a VRAM-derived default (often 2048-4096) that silently truncates the system
# prompt before its language rules - the agent then answers in English and invents
# identifiers. See SETUP.md.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=aruvi-base
LLM_API_KEY=ollama

# Required for the gated ASR model — see backend/README.md.
# HF_TOKEN=hf_your_token_here

# Optional — only set this if you want the /ws/audio handshake to require a
# shared-secret token (checked against a client's ?token= query param).
# AUDIO_WS_AUTH_TOKEN=
